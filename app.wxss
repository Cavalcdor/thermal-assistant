/* 全局样式 */
page {
  background-color: #F5F5F5;
  font-family: -apple-system-font, "Helvetica Neue", sans-serif;
}

/* 主色调 */
.primary-color {
  color: #0052D8;
}

.success-color {
  color: #07C160;
}

.error-color {
  color: #D9001B;
}

/* 通用容器 */
.container {
  padding: 30rpx;
}

/* 卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 输入框通用样式 */
.input-wrapper {
  position: relative;
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
  display: block;
}

.input-box {
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx;
  min-height: 88rpx;
}

.input-field {
  flex: 1;
  font-size: 40rpx;
  color: #333333;
  font-weight: 500;
}

.input-unit {
  font-size: 28rpx;
  color: #666666;
  margin-left: 12rpx;
}

.clear-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #CCCCCC;
  border-radius: 50%;
  margin-left: 12rpx;
}

.clear-icon {
  color: #FFFFFF;
  font-size: 28rpx;
}

/* 按钮样式 */
.btn-primary {
  background-color: #0052D9;
  color: #FFFFFF;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-secondary {
  background-color: #FFFFFF;
  color: #0052D9;
  border: 2rpx solid #0052D9;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
}

/* 提示文本 */
.hint-text {
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
}

.error-text {
  font-size: 24rpx;
  color: #D9001B;
  margin-top: 12rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #E5E5E5;
  margin: 24rpx 0;
}
