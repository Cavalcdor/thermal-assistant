page {
  background-color: #f6f6f6;
  font-family: sans-serif;
}

.container {
  padding: 20rpx;
}

/* 选项卡 */
.tabs {
  display: flex;
  background: #fff;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
}

.tab-item.active {
  color: #0052D9;
  font-weight: bold;
  border-bottom: 4rpx solid #0052D9;
}

/* 卡片 */
.card {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.segment-control {
  display: flex;
  background: #f0f0f0;
  padding: 6rpx;
  border-radius: 10rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #666;
}

.segment-item.active {
  background: #fff;
  color: #0052D9;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

/* 压力列表样式 */
.pressure-list-card {
  background: #fff;
  border-radius: 16rpx;
  margin-top: 10rpx;
  overflow: hidden;
}

.list-header {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #fafafa;
  font-size: 24rpx;
  color: #999;
  border-bottom: 1rpx solid #eee;
}

.pressure-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.unit-label {
  width: 160rpx;
}

.unit-main {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.unit-input {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: #0052D9;
  height: 60rpx;
}

.input-active {
  color: #000;
  font-weight: bold;
  background: #f0f6ff;
  padding-right: 10rpx;
  border-radius: 4rpx;
}

/* 通用输入框 */
.input-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.input-box {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  padding: 20rpx;
  border-radius: 12rpx;
}

.input-field {
  flex: 1;
  font-size: 34rpx;
}

.unit-picker-btn {
  background: #0052D9;
  color: #fff;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.result-box {
  background: #eef4ff;
}

.result-field {
  color: #0052D9;
  font-weight: bold;
}

/* 其它样式 */
.hint-text {
  font-size: 24rpx;
  color: #999;
  padding: 10rpx 20rpx;
}

.formula-card {
  padding: 20rpx;
  color: #ff9800;
  font-size: 24rpx;
  text-align: center;
}

.btn-primary {
  background: #0052D9;
  color: #fff;
  font-weight: bold;
  border-radius: 50rpx;
  margin-top: 40rpx;
  padding: 0rpx;
  font-size: 30rpx;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  font-size: 32rpx;
  padding: 10rpx 0;
}