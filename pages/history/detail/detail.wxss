/* pages/history/detail/detail.wxss */
page {
  background-color: #f5f5f5;
}

.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

/* 头部卡片 */
.header-card .title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.header-card .title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.header-card .sub-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.header-card .time {
  font-size: 24rpx;
  color: #999;
  border-top: 1rpx solid #eee;
  padding-top: 16rpx;
  margin-top: 16rpx;
}

/* 状态徽章 */
.status-badge {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.status-badge.pass {
  background: #E8F7ED;
  color: #07C160;
}

.status-badge.fail {
  background: #FFEAE9;
  color: #D9001B;
}

/* 详细参数列表 */
.section-header {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #0052D9;
}

.kv-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f9f9f9;
}

.kv-item:last-child {
  border-bottom: none;
}

.key {
  color: #666;
  font-size: 28rpx;
}

.value {
  color: #333;
  font-weight: 500;
  font-size: 28rpx;
  text-align: right;
}

/* 表格样式 */
.table-card {
  padding: 20rpx 0;
}

.section-header {
  margin-left: 20rpx;
}

.scroll-tip {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-bottom: 10rpx;
}

.table-scroll {
  width: 100%;
}

.table {
  display: flex;
  flex-direction: column;
  min-width: 1000rpx;
}

/* 强制宽度 */
.tr {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.tr.header {
  background: #f8f9fa;
  font-weight: bold;
  color: #666;
  font-size: 24rpx;
}

.th,
.td {
  padding: 20rpx 10rpx;
  text-align: center;
  width: 140rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 固定首列 */
.fixed-col {
  width: 120rpx;
  background: #fff;
  position: sticky;
  left: 0;
  z-index: 2;
  border-right: 1rpx solid #f0f0f0;
  box-shadow: 2rpx 0 4rpx rgba(0, 0, 0, 0.02);
}

.tr.header .fixed-col {
  background: #f8f9fa;
}

.text-pass {
  color: #07C160;
  font-weight: bold;
}

.text-fail {
  color: #D9001B;
  font-weight: bold;
}

/* 底部按钮 */
.footer-placeholder {
  height: 120rpx;
}

.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 10;
}

.btn-restore {
  background: #0052D9;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}