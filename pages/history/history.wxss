/* pages/history/history.wxss */
page {
  background-color: #F5F5F5;
  padding-bottom: 40rpx;
}

.container {
  padding: 0;
}

/* --- 顶部筛选栏 --- */
.filter-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
  box-sizing: border-box;
}

.tabs-scroll {
  flex: 1;
  width: 0;
  white-space: nowrap;
  display: flex;
}

/* --- 选项卡 --- */
.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  flex-shrink: 0;
  padding: 0 36rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.2s;
  box-sizing: border-box;
  height: 64rpx;
}

.tab-item.active {
  background: #0052D9;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0,82,217,0.3);
}

/* --- 垃圾桶按钮 --- */
.clear-btn {
  width: 64rpx;
  height: 64rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  margin-left: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.clear-btn:active {
  background: #e0e0e0;
  transform: scale(0.9);
}

.clear-btn .icon {
  font-size: 32rpx;
  color: #D9001B;
}

/* 列表卡片 */
.history-list {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
  transition: transform 0.1s;
}

.card:active {
  transform: scale(0.99);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f9f9f9;
}

.badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.badge.thermal { background: #E3F2FD; color: #1976D2; }
.badge.pressure { background: #E8F5E9; color: #2E7D32; }
.badge.tools { background: #FFF3E0; color: #EF6C00; }
.badge.unit_conversion { background: #F3E5F5; color: #7B1FA2; }
.badge.cems { background: #E0F7FA; color: #0097A7; }

.time {
  font-size: 24rpx;
  color: #999;
}

.card-content {
  margin-bottom: 24rpx;
}

.main-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: bold;
}
.status-tag.pass { border: 1rpx solid #07C160; color: #07C160; }
.status-tag.fail { border: 1rpx solid #D9001B; color: #D9001B; }

.sub-info {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.desc-info {
  font-size: 26rpx;
  color: #999;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.action-btn {
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.action-btn.restore {
  background: #F0F6FF;
  color: #0052D9;
}

.action-btn.delete {
  background: #FFF0F0;
  color: #D9001B;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 100rpx;
}

.empty-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.empty-state text {
  font-size: 28rpx;
  color: #999;
}