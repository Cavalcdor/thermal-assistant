<view class="container">
  
  <!-- 1. 功能菜单列表 -->
  <view class="card menu-card">
    <!-- 历史记录入口 -->
    <view class="menu-item" bindtap="goToHistoryTab">
      <view class="menu-left">
        <text class="menu-icon">📋</text>
        <text class="menu-text">历史记录</text>
      </view>
      <view class="menu-right">
        <text class="menu-badge" wx:if="{{totalCount > 0}}">{{totalCount}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 关于与支持入口 -->
    <view class="menu-item" bindtap="goToSettings">
      <view class="menu-left">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">关于与支持</text>
      </view>
      <view class="menu-right">
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 2. 最近记录列表 -->
  <view class="card history-card" wx:if="{{recentList.length > 0}}">
    <view class="section-title">
      <text class="title-text">最近记录</text>
      <text class="clear-btn" bindtap="clearAllHistory">清空</text>
    </view>

    <view class="history-list">
      <view 
        class="history-item" 
        wx:for="{{recentList}}" 
        wx:key="index"
        bindtap="goToDetail"
        data-index="{{item.originalIndex}}">
        
        <view class="history-main">
          <view class="history-header">
            <text class="type-badge {{item.type}}">{{item.typeLabel}}</text>
            <text class="history-time">{{item.timeLabel}}</text>
          </view>
          
          <view class="history-content-box">
            <text class="main-text">{{item.displayTitle}}</text>
            <text class="sub-text">{{item.displayDesc}}</text>
          </view>
        </view>

        <view class="history-delete" catchtap="deleteHistory" data-index="{{item.originalIndex}}">
          <text>删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 3. 空状态 -->
  <view class="empty-state" wx:if="{{recentList.length === 0}}">
    <text class="empty-icon">📊</text>
    <text class="empty-text">暂无历史记录</text>
    <text class="empty-hint">温度转换与压力校验结果将保存在这里</text>
  </view>

  <!-- 4. 版本信息 -->
  <view class="version-info">
  <text>© 2026 工控热工宝.All Rights Reserved.</text>
</view>
</view>