/* pages/profile/profile.wxss */
page {
  background-color: #F5F5F5;
  padding-bottom: 40rpx;
}

.container {
  padding: 20rpx;
}

/* 通用卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}

/* 1. 菜单列表样式 */
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: #fff;
}

.menu-item:active {
  background-color: #f9f9f9;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 38rpx;
  margin-right: 24rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-badge {
  background: #FF3B30;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.arrow {
  color: #ccc;
  font-size: 32rpx;
  font-weight: 300;
}

.divider {
  height: 1rpx;
  background: #f5f5f5;
  margin: 0 32rpx;
}

/* 2. 最近记录样式 */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.title-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.clear-btn {
  font-size: 22rpx;
  color: #666666;
  background-color: #f0f0f0;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 500;
  line-height: 1;
  transition: all 0.2s;
}

.clear-btn:active {
  background-color: #e0e0e0;
  color: #333333;
  transform: scale(0.9); 
}

.history-list {
  padding: 0;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f9f9f9;
}

.history-item:last-child {
  border-bottom: none;
}

.history-main {
  flex: 1;
  margin-right: 20rpx;
  overflow: hidden;
}

.history-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

/* 类型标签颜色 */
.type-badge {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  font-weight: bold;
}
.type-badge.thermal { background: #E3F2FD; color: #1976D2; }
.type-badge.pressure { background: #E8F5E9; color: #2E7D32; }
.type-badge.unit_conversion { background: #F3E5F5; color: #7B1FA2; }
.type-badge.cems { background: #FFF3E0; color: #EF6C00; }

.history-time {
  font-size: 22rpx;
  color: #ccc;
}

.history-content-box {
  display: flex;
  flex-direction: column;
}

.main-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub-text {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 删除按钮 */
.history-delete {
  padding: 10rpx 20rpx;
  background-color: #FFF0F0;
  border-radius: 30rpx;
}

.history-delete text {
  font-size: 24rpx;
  color: #D9001B;
}

/* 3. 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
}

/* 4. 版本信息 */
.version-info {
  text-align: center;
  margin-top: 40rpx;
}

.version-info text {
  font-size: 24rpx;
  color: #ccc;
}