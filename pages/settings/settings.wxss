/* 容器背景 */
page {
  background-color: #f6f6f6;
  padding-bottom: 40rpx;
}

.container {
  padding: 24rpx;
}

/* 顶部信息卡片 */
.header-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.app-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  text-align: center;
}

.app-version {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
  text-align: center;
}

/* 通用卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #0052D9;
}

/* 计算标准条目 */
.formula-item {
  margin-bottom: 16rpx;
}

.formula-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.formula-desc {
  font-size: 26rpx;
  color: #666;
}

/* 更新日志 */
.log-item {
  display: flex;
  margin-bottom: 30rpx;
}

.log-dot {
  width: 12rpx;
  height: 12rpx;
  background: #0052D9;
  border-radius: 50%;
  margin-top: 14rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.log-dot.gray {
  background: #ccc;
}

.log-content {
  flex: 1;
}

.log-version {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.log-text {
  font-size: 26rpx;
  color: #666;
  display: block;
  line-height: 1.6;
}

/* 待扩展功能样式 */
.todo-card {
  background: linear-gradient(to right, #ffffff, #f0f7ff);
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #0052D9;
}

.label-hint {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

.arrow {
  font-size: 24rpx;
  color: #ccc;
}

/* 免责声明 */
.disclaimer {
  padding: 20rpx;
  margin-bottom: 40rpx;
}

.disclaimer-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #888;
  display: block;
  margin-bottom: 10rpx;
  text-align: center;
}

.disclaimer-text {
  font-size: 22rpx;
  color: #aaa;
  line-height: 1.6;
  text-align: justify;
  display: block;
}

/* 操作区域 */
.action-section {
  padding: 0 40rpx;
}

.btn-feedback {
  background-color: #fff !important;
  color: #0052D9 !important;
  border: 2rpx solid #0052D9 !important;
  font-size: 30rpx;
  border-radius: 44rpx;
  font-weight: 500;
}